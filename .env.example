# E-commerce Backend Configuration
# Copy this file to .env and update values as needed.

# Database connection URL
# For PostgreSQL (recommended for production/development):
DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@localhost:5432/ecommerce
# For SQLite (testing only):
# DATABASE_URL=sqlite+aiosqlite:///./ecommerce.db

# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated list)
CORS_ORIGINS=["http://localhost:3000"]

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info
